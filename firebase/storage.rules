rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== BEGIN CHURCH BOOKS =====
    // Church Books files: orgs/{org}/files/{fileId}/{name}. Never replaced or deleted — "removing" a file
    // only hides it in the app and is logged. Source: Accounting/firebase/storage.rules.
    match /orgs/{org}/files/{fileId}/{name} {
      function booksMemberDoc() { return /databases/(default)/documents/orgs/$(org)/members/$(request.auth.uid); }
      function booksMember() { return request.auth != null && firestore.exists(booksMemberDoc()) && request.time.toMillis() < firestore.get(booksMemberDoc()).data.get('untilMs', 9999999999999); }
      function booksRole() { return firestore.get(booksMemberDoc()).data.role; }
      allow read: if booksMember() && booksRole() in ['owner', 'admin', 'bookkeeper', 'reviewer', 'viewer'];
      allow create: if resource == null && booksMember()
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('text/(csv|plain)') || request.resource.contentType.matches('message/rfc822')
            || request.resource.contentType.matches('application/vnd\\..*') || request.resource.contentType.matches('application/msword'));
      allow update, delete: if false;
    }
    // ===== END CHURCH BOOKS =====

    match /{all=**} { allow read, write: if false; }
  }
}
